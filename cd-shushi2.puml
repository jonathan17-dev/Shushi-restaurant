@startuml Casediagram
left to right direction
skinparam ClassAttributeIconSize 0
hide circle
hide empty attributes 
hide empty methods

class Klant {
   naam
   telefoonnummer
   reserveren
}

class Reservering {
   Datum 
   tijdstip alleen hele uren
}

class Restaurant {
   openingstijd : tijdstip = 17:00
   sluitingstijd : tijdstip = 23:00
   openingsdagen: 7
}

class Mederwerkers{
   Ober 
   Chefs
   Receptionist
}

class NAW{
   Naam 
   Adres 
   Woonplaats
}

class tafel
Restaurant -- "1..3" Zaal : "> heeft"
Restaurant -- "2" Ober : "> heeft"
Restaurant -- "6" chefs : "> heeft"
Klant -- Reservering : "> kan"
Restaurant-- Mederwerkers
Zaal-- tafel : "> 1..N"
Restaurant -- "1" Receptionist : "> heeft"
NAW-- Mederwerkers : "< heeft"
Reservering -- tafel : "> 1..1"
tafel -- Reservering : "> 1..N"

@enduml